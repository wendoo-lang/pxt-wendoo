{
    "name": "wendoo-vm",
    "version": "0.0.0",
    "description": "The Wendoo bytecode VM for MakeCode, in Static TypeScript: target-agnostic, no blocks, no target-specific dependencies. Game- and device-facing Wendoo extensions depend on this one.",
    "license": "MIT",
    "dependencies": {
        "core": "*"
    },
    "files": [
        "README.md",
        "main.ts",
        "value.ts",
        "bytecode.ts",
        "program.ts",
        "decoder.ts",
        "handle.ts",
        "context.ts",
        "core-host.ts",
        "vm.ts",
        "runtime.ts",
        "trace.ts",
        "conformance.ts"
    ],
    "supportedTargets": [
        "arcade"
    ],
    "preferredEditor": "tsprj"
}
