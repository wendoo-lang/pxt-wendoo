{
  "compilerOptions": {
    "target": "ES5",
    "ignoreDeprecations": "6.0",
    "noLib": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": false
  },
  "include": [
    "*.ts",
    "wendoo-lang/pxt-wendoo/*.ts",
    "../../../../extensions/vm/*.ts",
    "../../../../extensions/arcade-base/*.ts",
    "../../../../extensions/arcade-host/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/base/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/core/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/device/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/game/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/hw/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/mixer/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/power/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/screen/**/*.ts",
    "../../../../extensions/arcade-host/pxt_modules/settings/**/*.ts"
  ],
  "exclude": ["../../../../extensions/arcade-host/pxt_modules/**/*test.ts"]
}
