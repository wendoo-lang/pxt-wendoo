{
  "name": "pxt-wendoo",
  "description": "Wendoo for MakeCode: the Static TypeScript Wendoo VM and per-target integrations.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preinstall": "git submodule update --init --recursive",
    "bootstrap": "npm install && npm run build:deps",
    "install": "npm run install:simx && npm run install:apps",
    "install:simx": "npm --prefix makecode/simx install",
    "install:apps": "npm --prefix apps install",
    "build:deps": "npm --prefix apps run build:deps"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15"
  }
}
