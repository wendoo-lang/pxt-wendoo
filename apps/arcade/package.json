{
  "name": "@wendoo/arcade",
  "description": "Give your sprites a brain. Wendoo for MakeCode Arcade.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "scripts": {
    "predev": "npm run build:deps",
    "dev": "vite --config vite/config.dev.mjs --force",
    "prebuild": "npm run install:packages --prefix ../../external/wendoo-lang && npm run build:deps",
    "build": "vite build --config vite/config.prod.mjs",
    "build:deps": "node ../../external/wendoo-lang/scripts/build-packages.js .",
    "clean": "rm -rf dist && rm -rf node_modules/.vite",
    "check:only": "biome check ./src",
    "check": "biome check ./src --write",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "npm run build:deps",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')"
  },
  "dependencies": {
    "@wendoo/app-host": "file:../../external/wendoo-lang/packages/app-host",
    "@wendoo/bridge-app": "file:../../external/wendoo-lang/packages/bridge-app",
    "@wendoo/core": "file:../../external/wendoo-lang/packages/core",
    "@wendoo/ui": "file:../../external/wendoo-lang/packages/ui",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.1"
  }
}
