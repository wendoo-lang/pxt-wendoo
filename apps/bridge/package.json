{
  "name": "@wendoo/bridge",
  "description": "Relay service pairing two Wendoo session endpoints by join code and forwarding their messages verbatim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist"
    ],
    "postProcessed": false
  },
  "scripts": {
    "predev": "npm run build:deps",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build:prod",
    "start": "node dist/index.js",
    "prebuild": "npm run build:deps",
    "build": "tsc --build",
    "build:prod": "wireit",
    "build:deps": "node ../../external/wendoo-lang/scripts/build-packages.js .",
    "check:only": "biome check ./src",
    "check": "biome check ./src --write",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "npm run build:deps",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')"
  },
  "wireit": {
    "build:prod": {
      "command": "tsc --build tsconfig.prod.json",
      "dependencies": [
        "../../external/wendoo-lang/packages/bridge-protocol:build:prod"
      ],
      "files": [
        "src/**",
        "!src/**/*.spec.ts",
        "tsconfig.json",
        "tsconfig.prod.json",
        "package-lock.json"
      ],
      "output": [
        "dist/**",
        "tsconfig.prod.tsbuildinfo"
      ],
      "clean": true,
      "packageLocks": []
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@wendoo/bridge-protocol": "file:../../external/wendoo-lang/packages/bridge-protocol",
    "hono": "^4.12.7",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.3.0",
    "@wendoo/bridge-app": "file:../../external/wendoo-lang/packages/bridge-app",
    "@wendoo/bridge-client": "file:../../external/wendoo-lang/packages/bridge-client",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "wireit": "^0.14.13"
  }
}
