{
  "name": "@wendoo/editor",
  "description": "Wendoo editor for Microsoft MakeCode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "scripts": {
    "predev": "npm run build:deps",
    "dev": "vite --config vite/config.dev.mjs --force",
    "prebuild": "npm_config_audit=false npm_config_fund=false npm run install:packages --prefix ../../external/wendoo-lang && npm run build:deps",
    "build": "vite build --config vite/config.prod.mjs",
    "build:deps": "node ../../external/wendoo-lang/scripts/build-packages.js .",
    "clean": "rm -rf dist && rm -rf node_modules/.vite",
    "check:only": "biome check ./src",
    "check": "biome check ./src --write",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "npm run build:deps",
    "test": "tsx --disable-warning=ExperimentalWarning --tsconfig tsconfig.spec.json --import ./src/test-support/single-react.ts --test $(find src -name '*.spec.ts')",
    "gen:vm-programs": "tsx --tsconfig tsconfig.spec.json src/test-support/gen-vm-programs.ts"
  },
  "dependencies": {
    "@wendoo/bridge-app": "file:../../external/wendoo-lang/packages/bridge-app",
    "@wendoo/core": "file:../../external/wendoo-lang/packages/core",
    "@wendoo/docs": "file:../../external/wendoo-lang/packages/docs",
    "@wendoo/makecode-session": "file:../../packages/protocol",
    "@wendoo/ui": "file:../../external/wendoo-lang/packages/ui",
    "lucide-react": "^0.561.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@wendoo/bridge-session": "file:../../external/wendoo-lang/packages/bridge-session",
    "@wendoo/conformance": "file:../../external/wendoo-lang/packages/conformance",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.1"
  }
}
