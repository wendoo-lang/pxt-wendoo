{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"]
  },
  /* A spec's JSX is transformed under these options only where the file is included, so every
     source a spec renders is listed, the shared UI package's included. */
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.spec.ts",
    "src/test-support/element-tree.ts",
    "src/test-support/gen-vm-programs.ts",
    "src/test-support/single-react.ts",
    "src/components/AppHeader.tsx",
    "src/components/BrainDiagnostics.tsx",
    "src/components/BrainEditor.tsx",
    "src/components/BrainList.tsx",
    "src/components/CatalogDiagnosticsNotice.tsx",
    "src/components/ConfirmDialog.tsx",
    "src/components/ConnectPage.tsx",
    "src/components/ConnectionStatus.tsx",
    "src/components/DocsButton.tsx",
    "src/components/EndSession.tsx",
    "src/components/Modal.tsx",
    "src/components/NameInputDialog.tsx",
    "src/components/SaveStatus.tsx",
    "src/components/SessionView.tsx",
    "src/components/VersionNotice.tsx",
    "src/components/WendooLogo.tsx",
    "src/contexts/brains.tsx",
    "src/contexts/editor-session.tsx",
    "../../external/wendoo-lang/packages/ui/src/**/*.tsx",
    "../../external/wendoo-lang/packages/docs/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../external/wendoo-lang/packages/ui/src/**/*.spec.tsx",
    "../../external/wendoo-lang/packages/docs/src/**/*.spec.tsx"
  ]
}
